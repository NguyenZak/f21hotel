{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker.ts bọc worker của OpenNext (API đặt phòng nhẹ chạy trước khi nạp Next.js)
	"main": "worker.ts",
	"name": "f21hotel",
	// Tài khoản Cloudflare của khách sạn (Azlabs.it@gmail.com's Account)
	"account_id": "a53fd282b8369dffc65cf51b9e234e2a",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, tên service phải trùng tên worker
			"binding": "WORKER_SELF_REFERENCE",
			"service": "f21hotel"
		}
	],
	// CMS: dữ liệu ở D1 (ảnh ở Cloudinary, khai báo qua secret CLOUDINARY_*).
	// Chạy ở máy thì wrangler tự giả lập D1 (dựng bảng: npm run db:schema). Cấu trúc bảng: db/schema.sql
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "f21-hotel-cms",
			"database_id": "a35fdcd2-8455-43f3-9c39-c0641ebee789"
		}
	],
	// Bộ nhớ đệm trang (OpenNext): một KV namespace cho cả hai binding.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" }
	],
	"observability": { "enabled": true },
	// Mỗi 2 phút: tự build lại website khi CMS có nội dung mới đã lưu (src/cms/server/publish.ts).
	// Email nhắc khách trước ngày nhận phòng (worker.ts scheduled): 8:00 và 14:00 giờ Việt Nam (giờ UTC + 7).
	// Lần 14:00 chỉ gửi đơn chưa nhắc được (lỗi, hoặc khách đặt sau 8:00). Gửi email cần secret RESEND_API_KEY.
	"triggers": { "crons": ["*/2 * * * *", "0 1 * * *", "0 7 * * *"] },
	// Chỉ dùng lúc build (package.json "deploy": NEXT_DEV_WRANGLER_ENV=build). Trang website được dựng sẵn lúc build
	// và không dựng lại trên Workers (worker.ts), nên phải đọc D1 thật ("remote": true), không phải D1 giả lập ở máy.
	// Chỉ đọc, không ghi. `next dev` và `wrangler deploy` không dùng env này.
	"env": {
		"build": {
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "f21hotel" }],
			"d1_databases": [
				{
					"binding": "D1",
					"database_name": "f21-hotel-cms",
					"database_id": "a35fdcd2-8455-43f3-9c39-c0641ebee789",
					"remote": true
				}
			],
			"kv_namespaces": [
				{ "binding": "NEXT_INC_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" },
				{ "binding": "NEXT_TAG_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" }
			]
		}
	}
}
