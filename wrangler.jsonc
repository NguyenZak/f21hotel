{
	"$schema": "node_modules/wrangler/config-schema.json",
	// worker.ts bọc worker của OpenNext (API đặt phòng nhẹ chạy trước khi nạp Next.js)
	"main": "worker.ts",
	// worker.ts đọc build id của Next.js dưới dạng chữ (khoá KV tag cache)
	"rules": [{ "type": "Text", "globs": ["**/BUILD_ID"], "fallthrough": true }],
	"name": "f21hotel",
	// Tài khoản Cloudflare của khách sạn (Azlabs.it@gmail.com's Account)
	"account_id": "a53fd282b8369dffc65cf51b9e234e2a",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, tên service phải trùng tên worker
			"binding": "WORKER_SELF_REFERENCE",
			"service": "f21hotel"
		}
	],
	// CMS: dữ liệu ở D1 (ảnh ở Cloudinary, khai báo qua secret CLOUDINARY_*).
	// Chạy ở máy thì wrangler tự giả lập D1. Tạo bảng trên D1 thật: npm run deploy:database
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "f21-hotel-cms",
			"database_id": "a35fdcd2-8455-43f3-9c39-c0641ebee789"
		}
	],
	// Bộ nhớ đệm trang (OpenNext): một KV namespace cho cả hai binding.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" }
	],
	"observability": { "enabled": true },
	// Môi trường "remote": chỉ để các lệnh CMS chạy từ máy (npm run deploy:database, seed:remote)
	// đọc/ghi D1 thật. Không deploy môi trường này; `next dev` vẫn dùng D1 giả lập.
	"env": {
		"remote": {
			"d1_databases": [
				{
					"binding": "D1",
					"database_name": "f21-hotel-cms",
					"database_id": "a35fdcd2-8455-43f3-9c39-c0641ebee789",
					"remote": true
				}
			],
			// Khai báo lại cho đủ (wrangler không kế thừa binding sang môi trường); hai binding này không dùng khi chạy lệnh CMS
			"kv_namespaces": [
				{ "binding": "NEXT_INC_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" },
				{ "binding": "NEXT_TAG_CACHE_KV", "id": "df3ae53b3e8342e4a6430b63e4e5f695" }
			],
			"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "f21hotel" }]
		}
	}
	// Secret (đặt bằng `npx wrangler secret put BOOKING_WEBHOOK_URL`):
	//   BOOKING_WEBHOOK_URL — URL Google Apps Script nhận yêu cầu đặt phòng
}
