{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "f21-hotel-web",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, tên service phải trùng tên worker
			"binding": "WORKER_SELF_REFERENCE",
			"service": "f21-hotel-web"
		}
	],
	// CMS: dữ liệu ở D1 (ảnh ở Cloudinary, khai báo qua secret CLOUDINARY_*).
	// Trước khi deploy lần đầu: `npx wrangler d1 create f21-hotel-cms` rồi thay database_id.
	// Chạy ở máy thì wrangler tự giả lập D1.
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "f21-hotel-cms",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	// Bộ nhớ đệm trang (OpenNext): một KV namespace cho cả hai binding.
	// Trước khi deploy lần đầu: `npx wrangler kv namespace create f21-hotel-cache` rồi thay id.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "00000000000000000000000000000000" },
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "00000000000000000000000000000000" }
	],
	"observability": { "enabled": true }
	// Secret (đặt bằng `npx wrangler secret put BOOKING_WEBHOOK_URL`):
	//   BOOKING_WEBHOOK_URL — URL Google Apps Script nhận yêu cầu đặt phòng
}
