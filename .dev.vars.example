# Sao chép thành .dev.vars để chạy thử ở máy
NEXTJS_ENV=development
BOOKING_WEBHOOK_URL=
# CMS (Payload): khoá bí mật, đặt trên Cloudflare bằng `npx wrangler secret put PAYLOAD_SECRET`
PAYLOAD_SECRET=
# Chỉ dùng ở máy dev: mật khẩu cho 3 tài khoản thử nghiệm khi chạy npm run seed
SEED_PASSWORD=
# Cloudinary (lưu ảnh của CMS). Trên Cloudflare đặt bằng `npx wrangler secret put CLOUDINARY_API_SECRET`…
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=f21-hotel

# Chỉ dùng khi tạo tài khoản Chủ bằng npm run create-admin(:remote); xoá ADMIN_PASSWORD sau khi tạo xong
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
