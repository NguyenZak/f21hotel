{
  "name": "f21-hotel-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:cf": "NEXT_DEV_WRANGLER_ENV=build opennextjs-cloudflare build",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "create-admin": "node scripts/create-admin.mjs",
    "create-admin:remote": "node scripts/create-admin.mjs --remote",
    "db:schema": "wrangler d1 execute D1 --local --file db/schema.sql",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opennextjs/cloudflare": "^1.20.14",
    "@payloadcms/db-d1-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-cloud-storage": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@puckeditor/core": "0.24.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "cmdk": "^1.1.1",
    "graphql": "^16.14.2",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "payload": "3.92.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.15.3",
    "recharts": "^3.10.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "patch-package": "8.0.1",
    "typescript": "^5",
    "wrangler": "^4.155.0"
  }
}
